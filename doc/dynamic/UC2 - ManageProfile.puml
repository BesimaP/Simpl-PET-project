@startuml
!pragma layout smetana
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title UC2: ManageProfile

actor "Patient" as u
participant "opretprofil.html /\nmin-profil.html" as v
participant "Javalin" as j
participant "LoginController /\nProfileController" as c
participant "AuthService /\nProfileService" as s
participant "DashboardService" as ds
participant "PatientMapper" as pm
participant "ConnectionPool" as cp
database "PostgreSQL" as db

== Create profile (LoginController + AuthService) ==
u -> v : Fills in name, date of birth, username, password and\n"forløb?" (Nej/Ja + start date), clicks "Opret profil"
v -> j : POST /opretprofil (firstName, lastName, dateOfBirth,\nusername, password, hasJourney, journeyStart)
j -> c : createProfile(ctx)
c -> s : createProfile(firstName, lastName, dateOfBirth,\nusername, password, hasJourney, journeyStart)
s -> s : isBlank(...), LocalDate.parse(dateOfBirth / journeyStart),\ndateOfBirth not in the future, password.length() >= 8
alt Empty field, invalid date or password too short
  s --> c : INVALID_INPUT
  c --> j : ctx.redirect("/opretprofil?fejl=felter")
else Fields OK
  s -> pm : findByUsername(username)
  pm -> cp : getConnection()
  cp --> pm : Connection
  pm -> db : SELECT * FROM patient WHERE username = ?
  db --> pm : ResultSet
  pm --> s : Patient (or null)
  note right of pm : Connection is returned to the pool\nautomatically (try-with-resources)
  alt Username already taken
    s --> c : ALREADY_EXISTS
    c --> j : ctx.redirect("/opretprofil?fejl=brugernavn")
    j --> u : "Brugernavnet er optaget."
  else Username free
    s -> pm : save(new Patient(0, username,\nBCrypt.hashpw(password, ...), firstName, lastName, dob))
    pm -> cp : getConnection()
    cp --> pm : Connection
    pm -> db : INSERT INTO patient (username, password_hash, first_name,\nlast_name, date_of_birth) VALUES (?, ?, ?, ?, ?)
    pm --> s : patientId (generated key)
    opt hasJourney = "yes"
      s -> ds : createJourney(patientId, journeyStart) (see UC3)
    end
    s --> c : OK
    c -> s : login(username, password) (as UC1)
    c -> c : ctx.sessionAttribute("patientId" / "patientName")
    c --> j : ctx.redirect("/dashboard?gemt=oprettet")
    j --> u : Dashboard with "Velkommen! Din profil er oprettet"
  end
end

== Edit name and date of birth (ProfileController + ProfileService) ==
note over u, c : Each /min-profil route: no patientId in session -> redirect /login
u -> v : Changes first/last name and/or date of birth, clicks "Gem ændringer"
v -> j : POST /min-profil (firstName, lastName, dateOfBirth)
j -> c : updateProfile(ctx)
c -> s : updateProfile(patientId, firstName, lastName, dateOfBirth)
s -> s : isBlank(...), LocalDate.parse(dateOfBirth),\nnot in the future
alt Empty field, invalid or future date
  s --> c : INVALID_INPUT
  c --> j : ctx.redirect("/min-profil?fejl=felter")
else OK
  s -> pm : updateProfile(id, firstName, lastName, dob)
  pm -> cp : getConnection()
  cp --> pm : Connection
  pm -> db : UPDATE patient SET first_name = ?, last_name = ?,\ndate_of_birth = ? WHERE id = ?
  s --> c : OK
  c -> c : ctx.sessionAttribute("patientName", new name)
  c --> j : ctx.redirect("/min-profil?gemt=1")
end
j --> u : GET /min-profil -> min-profil.html with message

== Delete account ==
alt JavaScript on
  u -> v : Clicks "Slet konto" – min-profil.js opens the dialog\n("Annullér" just closes it)
else JavaScript off
  u -> j : GET /slet-konto (the link)
  j -> c : showDeleteAccount(ctx)
  c --> j : ctx.render("bekraeft") (title, text, action = /slet-konto)
  j --> u : Confirmation page "Slet din konto?" ("Annullér" -> /min-profil)
end
u -> v : Confirms "Slet konto"
v -> j : POST /slet-konto
j -> c : deleteAccount(ctx)
c -> s : deleteAccount(patientId)
s -> s : documents = documentService.getDocuments(patientId)\n(remember her files BEFORE the rows are gone)
s -> pm : delete(id)
pm -> cp : getConnection()
cp --> pm : Connection
pm -> db : DELETE FROM patient WHERE id = ?\n(ON DELETE CASCADE removes all her data)
s -> s : documentService.deleteFiles(documents)\n(deletes her uploaded files in uploads/ –\nCASCADE only removes the rows)
s --> c : OK
c -> c : ctx.req().getSession().invalidate()
c --> j : ctx.redirect("/login")
j --> u : login.html

@enduml
