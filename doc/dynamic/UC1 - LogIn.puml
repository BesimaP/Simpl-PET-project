@startuml
!pragma layout smetana

title UC1: LogIn

actor "Patient" as u
participant "login.html" as v
participant "Javalin" as j
participant "LoginController" as c
participant "AuthService" as s
participant "PatientMapper" as pm
participant "ConnectionPool" as cp
database "PostgreSQL" as db

u -> v : Fills in username and password, clicks "Log ind"
v -> j : POST /login (username, password)
j -> c : login(ctx)
c -> c : ctx.formParam("username"), ctx.formParam("password")
c -> s : login(username, password)
s -> pm : findByUsername(username)
pm -> cp : getConnection()
cp --> pm : Connection
pm -> db : SELECT * FROM patient WHERE username = ?
db --> pm : ResultSet
pm -> pm : new Patient(...) from the row
pm --> s : Patient (or null)
note right of pm : Connection is returned to the pool\nautomatically (try-with-resources)

alt No patient or BCrypt.checkpw fails
  s --> c : throw UserNotFoundException
  c -> c : ctx.attribute("error", message)
  c --> j : ctx.render("login")
  j --> u : login.html with "Forkert brugernavn eller kodeord"
else Login OK
  s --> c : Patient
  c -> c : ctx.sessionAttribute("patientId", id)\nctx.sessionAttribute("patientName", name)
  c --> j : ctx.redirect("/dashboard")
  j --> u : Dashboard
end

@enduml
