
@startuml
!pragma layout smetana

title UC1: LogIn

actor "Patient" as u
participant "LoginView" as v
participant "LoginController" as c
participant "Session" as m
database "SQLite" as db

u -> v : Opens application
v --> u : Shows login screen

u -> v : Fills in username and password
u -> v : Clicks Log in
v -> c : handleLogin(username, password)

alt Fields are empty
  c --> v : showError()
  v --> u : "Please fill in all fields"
else Fields filled
  c -> db : SELECT * FROM patient WHERE username = ?
  db --> c : ResultSet
  alt No patient found or hash does not match
    c --> v : showError()
    v --> u : "Wrong username or password"
  else Login OK
    c -> m : setPatient(patient)
    c -> db : SELECT * FROM fertility_journey WHERE patient_id = ? AND status = 'ACTIVE'
    db --> c : ResultSet
    alt Active journey found
      c -> m : setJourney(journey)
      c --> v : showDashboard()
      v --> u : Shows dashboard
    else No active journey
      c --> v : showCreateJourney()
      v --> u : Shows "Start nyt forløb" (UC3)
    end
  end
end

alt Database error
  c --> v : showError()
  v --> u : "Could not read database"
end

@enduml
