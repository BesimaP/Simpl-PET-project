@startuml
!pragma layout smetana
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title UC10: LogMedication

actor "Patient" as u
participant "medicin.html" as v
participant "Javalin" as j
participant "MedicationController" as c
participant "MedicationService" as s
participant "RoundService" as rs
participant "MedicationMapper" as mm
participant "MedicationLogMapper" as lm
participant "ConnectionPool" as cp
database "PostgreSQL" as db

note over j, c : Every handler first checks ctx.sessionAttribute("patientId")\nnull (not logged in) → ctx.redirect("/login")

== Show checklist ==
u -> v : Opens "Medicin"
v -> j : GET /medicin
j -> c : showLogs(ctx)
c -> s : getTodayLogs(patientId), getUpcomingLogs(patientId),\ngetPastLogs(patientId) (I dag / Kommende / Tidligere)
s -> rs : findActiveRound(patientId) (RoundMapper)
alt NoActiveJourneyException / NoActiveRoundException
  rs --> s : throw
  s --> c : empty lists
else Active round
  rs --> s : Round
  s -> lm : findByRound(roundId)
  lm -> cp : getConnection()
  cp --> lm : Connection
  lm -> db : SELECT medication_log.*, medication.unit FROM medication_log\nJOIN medication ON medication.id = medication_log.medication_id\nWHERE medication_log.round_id = ? ORDER BY medication_log.scheduled_date_time
  db --> lm : ResultSet
  lm -> lm : mapRow(rs) per row
  lm --> s : List<MedicationLog>
  note right of lm : Every mapper call gets its own Connection via\ngetConnection(); it is returned to the pool\nautomatically (try-with-resources)
  s --> c : today / upcoming / past (split on LocalDate.now())
end
c -> s : getMedicationNames(), getMedications()
s -> mm : findAll() : SELECT * FROM medication ORDER BY description
mm --> s : List<Medication> (name, description, unit)
s --> c : Map<id, description> + List<Medication>
c --> j : ctx.render("medicin") (today, upcoming, past, names, medications, gemt, fejl)
j --> u : medicin.html: dropdown "Gonal-F (IU)" … (th:each over medications)\n+ "I dag" / "Kommende" / "Tidligere"

== Log a dose ==
u -> v : Selects medication (list shows its unit, e.g. "Gonal-F (IU)"),\nfills in dose, date, time (optional "taken"), clicks "Gem medicin"
v -> j : POST /medicin (medication, dose, date, time, taken)
j -> c : logDose(ctx)
c -> s : logDose(patientId, medication, dose, date, time, taken)
alt Blank field, dose not a number / <= 0, invalid date/time
  s --> c : INVALID_INPUT
else Input OK
  s -> mm : findByName(medication)
  mm -> db : SELECT * FROM medication WHERE name = ?
  mm --> s : Medication (or null → INVALID_INPUT)
  s -> rs : findActiveRound(patientId) (RoundMapper)
  alt NoActiveJourneyException
    s --> c : NO_ACTIVE_JOURNEY
  else NoActiveRoundException
    s --> c : NO_ACTIVE_ROUND
  else Active round
    rs --> s : Round
    s -> lm : save(new MedicationLog(0, roundId, medicationId, scheduled, dose, medication.getUnit(), taken))
    lm -> db : INSERT INTO medication_log (round_id, medication_id, scheduled_date_time,\ndose, taken) VALUES (?, ?, ?, ?, ?)\n(unit is NOT stored here – it lives on medication)
    lm --> s : id
    s --> c : OK
  end
end
alt OK
  c --> j : ctx.redirect("/medicin?gemt=1")
  j --> u : Updated checklist with "Gemt ✓"
else INVALID_INPUT / NO_ACTIVE_JOURNEY / NO_ACTIVE_ROUND
  c --> j : ctx.redirect("/medicin?fejl=felter | intet-forloeb | ingen-runde")
  j --> u : "Udfyld alle felter ..." / "Start et forløb først." / "Start en runde først."
end

== Mark as taken ==
u -> v : Clicks the check button on a dose
v -> j : POST /medicin/taget (id)
j -> c : markTaken(ctx)
c -> s : markTaken(patientId, logId)
s -> s : isOwnDose(patientId, logId)\n(is the id in the patient's own round? otherwise NOT_FOUND)
s -> lm : markTaken(logId)
lm -> db : UPDATE medication_log SET taken = TRUE WHERE id = ?
s --> c : OK
c --> j : ctx.redirect("/medicin")
j --> u : Dose shown as taken
note over c, lm : POST /medicin/ikke-taget → markNotTaken(patientId, logId)\nworks the same way (incl. the ownership check) with SET taken = FALSE (undo)

== Delete a dose ==
u -> v : Clicks "Slet" on a dose (e.g. a typo: 1500 instead of 150)
v -> j : POST /medicin/slet (id in hidden field)
j -> c : deleteDose(ctx)
c -> c : Integer.parseInt(ctx.formParam("id"))
alt id is not a number
  c --> j : ctx.redirect("/medicin?fejl=ukendt")
else id OK
  c -> s : deleteDose(patientId, logId)
  s -> s : isOwnDose(patientId, logId)
  alt Not found / not hers
    s --> c : NOT_FOUND
    c --> j : ctx.redirect("/medicin?fejl=ukendt")
  else Her own dose
    s -> lm : delete(logId)
    lm -> cp : getConnection()
    cp --> lm : Connection
    lm -> db : DELETE FROM medication_log WHERE id = ?
    s --> c : OK
    c --> j : ctx.redirect("/medicin?gemt=slettet")
  end
end
j --> u : Updated checklist with "Slettet ✓"

@enduml
