@startuml
!pragma layout smetana
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title UC13: ViewRoundHistory

actor "Patient" as u
participant "rundehistorik.html" as v
participant "Javalin" as j
participant "DashboardController" as c
participant "RoundService" as s
participant "DashboardService" as ds
participant "FertilityJourneyMapper" as fm
participant "RoundMapper" as rm
participant "ConnectionPool" as cp
database "PostgreSQL" as db

u -> j : GET /rundehistorik (clicks "Historik")
j -> c : showRounds(ctx)
note right of c : patientId == null (not logged in)\n→ ctx.redirect("/login")

c -> ds : getJourneys(patientId)
ds -> fm : findByPatient(patientId)
fm -> cp : getConnection()
cp --> fm : Connection
fm -> db : SELECT fertility_journey.*, journey_status.name AS journey_status\nFROM fertility_journey JOIN journey_status ON ...\nWHERE fertility_journey.patient_id = ? ORDER BY start_date DESC
db --> fm : ResultSet
fm --> ds : List<FertilityJourney> (active AND completed, newest first)
ds --> c : List<FertilityJourney>

c -> s : getRoundsPerJourney(patientId)
s -> ds : getJourneys(patientId) (same SELECT as above)
loop for each journey
  s -> rm : findByJourney(journeyId)
  rm -> cp : getConnection()
  cp --> rm : Connection
  rm -> db : SELECT round.*, treatment_type.name, result.name FROM round\nJOIN treatment_type ... LEFT JOIN result ...\nWHERE round.fertility_journey_id = ? ORDER BY round.round_number
  db --> rm : ResultSet
  rm -> rm : mapRow(rs)\n(status = end_date == null ? IN_PROGRESS : COMPLETED)
  rm --> s : List<Round>
end
s --> c : Map<journeyId, List<Round>> (LinkedHashMap – keeps the order)
note right of rm : Connection is returned to the pool\nautomatically (try-with-resources)

c -> c : ctx.attribute("journeys", ...), ctx.attribute("roundsPerJourney", ...)
c --> j : ctx.render("rundehistorik")

alt No journeys
  j --> u : "Ingen forløb endnu. Start dit forløb på forsiden."
else Journeys found
  j --> u : One card per journey ("Forløb startet 15. jan. 2026 · afsluttet")\nwith its rounds: number, type, dates, result (Positiv/Negativ), "Aktiv"/"Afsluttet"
  alt Clicks "→" on a round
    u -> v : Clicks "→"
    v -> j : GET /tidslinje?runde={id} (UC11)
  else Clicks "Aftaler →" on a journey
    u -> v : Clicks "Aftaler →"
    v -> j : GET /aftaler?forloeb={id} (UC5)
  end
end

@enduml
