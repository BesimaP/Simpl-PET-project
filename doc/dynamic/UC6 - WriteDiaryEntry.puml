@startuml
!pragma layout smetana
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title UC6: WriteDiaryEntry

actor "Patient" as u
participant "dagbog.html" as v
participant "Javalin" as j
participant "DiaryController" as c
participant "DiaryService" as s
participant "DiaryEntryMapper" as dm
participant "ConnectionPool" as cp
database "PostgreSQL" as db

note over u, c : All routes: no patientId in session -> ctx.redirect("/login")

== Show entries ==
u -> j : GET /dagbog (menu "Dagbog")
j -> c : showEntries(ctx)
c -> s : getEntries(patientId)
s -> dm : findByPatient(patientId)
dm -> cp : getConnection()
cp --> dm : Connection
dm -> db : SELECT * FROM diary_entry WHERE patient_id = ? ORDER BY date_time DESC
db --> dm : ResultSet
loop for each row
  dm -> dm : mapRow(rs)
end
dm --> s : List<DiaryEntry>
note right of dm : Connection is returned to the pool\nautomatically (try-with-resources)
s --> c : List<DiaryEntry>
c -> c : ctx.attribute("entries", list)\nctx.attribute("gemt"/"fejl", ctx.queryParam(...))
c --> j : ctx.render("dagbog")
j --> u : dagbog.html with "Tidligere noter"

== Save entry ==
u -> v : Fills in date, title and note under "Skriv dagens note",\nclicks "Gem note"
v -> j : POST /dagbog (date, title, note)
j -> c : saveEntry(ctx)
c -> s : saveEntry(patientId, date, title, note)
alt Date, title or note empty, or invalid date
  s --> c : INVALID_INPUT
  c --> j : ctx.redirect("/dagbog?fejl=felter")
else All OK
  s -> s : LocalDate.parse(date).atStartOfDay()
  s -> dm : save(new DiaryEntry(0, patientId, dateTime, title, note))
  dm -> cp : getConnection()
  cp --> dm : Connection
  dm -> db : INSERT INTO diary_entry (patient_id, date_time, title, content) VALUES (?, ?, ?, ?)
  dm --> s : id (generated key)
  s --> c : OK
  c --> j : ctx.redirect("/dagbog?gemt=1")
end
j --> u : GET /dagbog again: list + "Gemt" or "Udfyld alle felter ..."

== Delete entry ==
u -> v : Clicks "Slet" on a note
v -> j : POST /dagbog/slet (id)
j -> c : deleteEntry(ctx)
c -> s : deleteEntry(patientId, entryId)
s -> dm : delete(entryId, patientId)
dm -> cp : getConnection()
cp --> dm : Connection
dm -> db : DELETE FROM diary_entry WHERE id = ? AND patient_id = ?
dm --> s : true if a row was deleted
alt true (entry belonged to the patient)
  s --> c : OK
  c --> j : ctx.redirect("/dagbog?gemt=slettet")
else Not found / not hers, or id not a number
  c --> j : ctx.redirect("/dagbog?fejl=ukendt")
end

@enduml
