@startuml
!pragma layout smetana

title UC14: EndRound

actor "Patient" as u
participant "dashboard.html" as v
participant "Javalin" as j
participant "DashboardController" as c
participant "RoundService" as s
participant "DashboardService" as ds
participant "RoundMapper" as rm
participant "ConnectionPool" as cp
database "PostgreSQL" as db

u -> v : Clicks "Afslut runde"
v --> u : dashboard.js opens dialog "Afslut runde N?" with "Resultat":\n"Ikke afgjort endnu" / "Positiv" / "Negativ"
u -> v : Selects result (optional), clicks "Afslut runde"
v -> j : POST /afslut-runde (result)
j -> c : endRound(ctx)
note right of c : patientId == null (not logged in)\n→ ctx.redirect("/login")
c -> c : ctx.formParam("result")\nblank → null, else Result.valueOf(result)
c -> s : endRound(patientId, result)
s -> s : findActiveRound(patientId)
s -> ds : findActiveJourney(patientId) (FertilityJourneyMapper)

alt No active journey
  ds --> s : throw NoActiveJourneyException
  s --> c : NO_ACTIVE_ROUND
  c --> j : ctx.redirect("/dashboard?fejl=ingen-runde")
  j --> u : "Start en runde først."
else Journey found
  ds --> s : FertilityJourney
  s -> rm : findActiveByJourney(journeyId)
  rm -> cp : getConnection()
  cp --> rm : Connection
  rm -> db : SELECT round.*, treatment_type.name, result.name FROM round JOIN treatment_type\nLEFT JOIN result WHERE round.fertility_journey_id = ? AND round.end_date IS NULL
  db --> rm : ResultSet
  rm -> rm : mapRow(rs)
  rm --> s : Round (or null)
  note right of rm : Connection is returned to the pool\nautomatically (try-with-resources)
  alt No round in progress (null)
    s -> s : throw NoActiveRoundException (caught)
    s --> c : NO_ACTIVE_ROUND
    c --> j : ctx.redirect("/dashboard?fejl=ingen-runde")
    j --> u : "Start en runde først."
  else Round in progress
    s -> rm : endRound(roundId, LocalDate.now(), result)
    rm -> cp : getConnection()
    cp --> rm : Connection
    rm -> db : UPDATE round SET end_date = ?, result_id = (SELECT id FROM result WHERE name = ?) WHERE id = ?
    db --> rm : OK
    rm --> s : void
    s --> c : OK
    c --> j : ctx.redirect("/rundehistorik?gemt=afsluttet")
    j --> u : rundehistorik.html with "Runden er afsluttet ✓"\n(dashboard can now offer "Start runde", UC8)
  end
end

@enduml
