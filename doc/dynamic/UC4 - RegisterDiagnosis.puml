@startuml
!pragma layout smetana
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title UC4: RegisterDiagnosis

actor "Patient" as u
participant "diagnoser.html" as v
participant "Javalin" as j
participant "DiagnosisController" as c
participant "DiagnosisService" as s
participant "DiagnosisMapper" as dm
participant "ConnectionPool" as cp
database "PostgreSQL" as db

note over u, c : Both routes: no patientId in session -> ctx.redirect("/login")

== Show diagnoses ==
u -> j : GET /diagnoser (menu "Diagnoser")
j -> c : showDiagnoses(ctx)
c -> s : getDiagnoses(patientId)
s -> dm : findByPatient(patientId)
dm -> cp : getConnection()
cp --> dm : Connection
dm -> db : SELECT * FROM diagnosis WHERE patient_id = ? ORDER BY name
db --> dm : ResultSet
loop for each row
  dm -> dm : mapRow(rs)
end
dm --> s : List<Diagnosis>
note right of dm : Connection is returned to the pool\nautomatically (try-with-resources)
s --> c : List<Diagnosis>
c -> c : ctx.attribute("diagnoses", list)\nctx.attribute("gemt"/"fejl", ctx.queryParam(...))
c --> j : ctx.render("diagnoser")
j --> v : diagnoser.html
v --> u : Shows "Dine diagnoser"

== Add diagnosis ==
u -> v : Fills in name and description (optional) under "Ny diagnose",\nclicks "Gem diagnose"
v -> j : POST /diagnoser (diagnosis, description)
j -> c : addDiagnosis(ctx)
c -> c : ctx.formParam("diagnosis"), ctx.formParam("description")
c -> s : addDiagnosis(patientId, name, description)
alt Name is empty
  s --> c : INVALID_INPUT
  c --> j : ctx.redirect("/diagnoser?fejl=felter")
  j --> u : diagnoser.html with "Udfyld alle felter ..."
else Name filled
  s -> s : empty description -> null
  s -> dm : save(new Diagnosis(0, patientId, name, desc))
  dm -> cp : getConnection()
  cp --> dm : Connection
  dm -> db : INSERT INTO diagnosis (patient_id, name, description) VALUES (?, ?, ?)
  db --> dm : generated id
  dm --> s : id
  s --> c : OK
  c --> j : ctx.redirect("/diagnoser?gemt=1")
  j --> u : GET /diagnoser again: updated list with "Gemt"
end

@enduml
