@startuml
!pragma layout smetana
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title UC8: StartRound

actor "Patient" as u
participant "start-runde.html" as v
participant "Javalin" as j
participant "DashboardController" as c
participant "RoundService" as s
participant "DashboardService" as ds
participant "RoundMapper" as rm
participant "TimelineService" as ts
participant "ConnectionPool" as cp
database "PostgreSQL" as db

u -> j : Clicks "Start runde" on dashboard (GET /start-runde)
j -> c : showStartRound(ctx)
c -> c : ctx.attribute("gemt"/"fejl", ctx.queryParam(...))
c --> j : ctx.render("start-runde")
j --> v : start-runde.html (Thymeleaf)
v -> v : start-runde.js: setTodayIn(startDate)
u -> v : Selects "Type behandling" (IVF/ICSI/IUI/FET), "Startdato", clicks "Start runde"
v -> j : POST /start-runde (type, startDate)
j -> c : startRound(ctx)
note right of c : patientId == null (not logged in)\n→ ctx.redirect("/login")
c -> c : ctx.formParam("type"), ctx.formParam("startDate")
c -> s : startRound(patientId, type, startDate)

alt type or startDate empty
  s --> c : INVALID_INPUT
  c --> j : ctx.redirect("/start-runde?fejl=felter")
  j --> u : start-runde.html with "Udfyld alle felter …"
else No active journey
  s -> ds : findActiveJourney(patientId) (FertilityJourneyMapper)
  ds --> s : throw NoActiveJourneyException
  s --> c : NO_ACTIVE_JOURNEY
  c --> j : ctx.redirect("/dashboard")
  j --> u : Dashboard shows "start dit forløb"
else Journey found
  s -> ds : findActiveJourney(patientId) (FertilityJourneyMapper)
  ds --> s : FertilityJourney
  s -> rm : findActiveByJourney(journeyId)
  rm -> cp : getConnection()
  cp --> rm : Connection
  rm -> db : SELECT round.*, treatment_type.name, result.name FROM round JOIN treatment_type\nLEFT JOIN result WHERE round.fertility_journey_id = ? AND round.end_date IS NULL
  db --> rm : ResultSet
  rm -> rm : mapRow(rs)
  rm --> s : Round (or null)
  note right of rm : Connection is returned to the pool\nautomatically (try-with-resources)
  alt Round already in progress
    s --> c : ROUND_IN_PROGRESS
    c --> j : ctx.redirect("/dashboard?fejl=runde-i-gang")
    j --> u : "Der er allerede en runde i gang."
  else No round in progress
    s -> rm : findByJourney(journeyId)
    rm -> cp : getConnection()
    cp --> rm : Connection
    rm -> db : SELECT round.*, ... WHERE round.fertility_journey_id = ? ORDER BY round.round_number
    db --> rm : ResultSet
    rm -> rm : mapRow(rs)
    rm --> s : List<Round>
    s -> s : roundNumber = size() + 1\nTreatmentType.valueOf(type), LocalDate.parse(startDate)
    alt valueOf/parse fails
      s --> c : INVALID_INPUT
      c --> j : ctx.redirect("/start-runde?fejl=felter")
      j --> u : start-runde.html with "Udfyld alle felter …"
    else OK
      s -> rm : save(new Round(0, journeyId, roundNumber, treatmentType, start, null, IN_PROGRESS, null))
      rm -> cp : getConnection()
      cp --> rm : Connection
      rm -> db : INSERT INTO round (fertility_journey_id, round_number, treatment_type_id, start_date)\nVALUES (?, ?, (SELECT id FROM treatment_type WHERE name = ?), ?)
      db --> rm : generated id
      rm --> s : id (round.setId)
      s -> ts : addEvent(roundId, start.atStartOfDay(), STIMULATION_START, treatmentType.name())
      ts -> db : INSERT INTO event ... (via EventMapper.save)
      s --> c : OK
      c --> j : ctx.redirect("/dashboard?gemt=runde")
      j --> u : Dashboard with new round and "Runden er startet ✓"
    end
  end
end

@enduml
