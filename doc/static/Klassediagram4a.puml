@startuml
!pragma layout smetana

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classHeaderBackgroundColor white
skinparam packageBackgroundColor white
skinparam packageBorderColor #555555
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor #555555
skinparam ArrowColor black
skinparam enumBackgroundColor white
skinparam enumBorderColor black
hide circle

title Klassediagram 4a — model og enums (Simpl v2)

' Gettere/settere og setId() er udeladt for læsbarhed.
' Kun metoder med egen logik vises (getDoseText, getValueText, addPoint, getPolyline …).
' Streger til enums er udeladt — koblingen fremgår af felttyperne

package "entities" {

  class Patient {
    - int id
    - String username
    - String passwordHash
    - String firstName
    - String lastName
    - LocalDate dateOfBirth
  }

  class Diagnosis {
    - int id
    - int patientId
    - String name
    - String description
  }

  class FertilityJourney {
    - int id
    - int patientId
    - LocalDate startDate
    - JourneyStatus status
  }

  class Round {
    - int id
    - int fertilityJourneyId
    - int roundNumber
    - TreatmentType treatmentType
    - LocalDate startDate
    - LocalDate endDate
    - RoundStatus status
    - Result result
  }

  class Appointment {
    - int id
    - int fertilityJourneyId
    - LocalDateTime dateTime
    - AppointmentType appointmentType
    - String location
  }

  class DiaryEntry {
    - int id
    - int patientId
    - LocalDateTime dateTime
    - String title
    - String content
  }

  class Event {
    - int id
    - int roundId
    - LocalDateTime dateTime
    - EventType eventType
    - String description
  }

  class Medication {
    - int id
    - String name
    - String description
    - String unit
  }

  class MedicationLog {
    - int id
    - int roundId
    - int medicationId
    - LocalDateTime scheduledDateTime
    - double dose
    - String unit
    - boolean taken
    + String getDoseText()
  }

  class HormoneLog {
    - int id
    - int roundId
    - LocalDateTime dateTime
    - HormoneType hormoneType
    - double value
    - String unit
    + String getValueText()
  }

  ' Ikke en tabel i databasen – laves af HormoneService til kurven på hormoner-siden
  class HormoneCurve {
    - HormoneType type
    - String unit
    - double max
    - double average
    - double averageY
    - int skipped
    - List<Point> points
    + void addPoint(Point p)
    + void setAverage(double average, double averageY)
    + String getMaxText()
    + String getAverageText()
    + String getPolyline()
  }

  class "HormoneCurve.Point" as Point {
    - double x
    - double y
    - double value
    - String dateLabel
    + String getValueText()
  }

  class Document {
    - int id
    - int patientId
    - LocalDate uploadDate
    - String title
    - DocumentType documentType
    - String filePath
  }

  class Notification {
    - int id
    - int patientId
    - LocalDateTime dateTime
    - NotificationType notificationType
    - String title
    - String message
    - boolean read
  }

}

package "enums" {

  enum JourneyStatus {
    ACTIVE
    COMPLETED
  }

  enum TreatmentType {
    IVF
    ICSI
    IUI
    FET
    --
    - String label
    + String getLabel()
  }

  enum RoundStatus {
    IN_PROGRESS
    COMPLETED
  }

  enum Result {
    POSITIVE
    NEGATIVE
  }

  enum AppointmentType {
    CONSULTATION
    SCANNING
    BLOOD_TEST
    EGG_RETRIEVAL
    EMBRYO_TRANSFER
    PREGNANCY_TEST
  }

  enum EventType {
    STIMULATION_START
    EGG_RETRIEVAL
    FERTILISATION
    EMBRYO_TRANSFER
    PREGNANCY_TEST
  }

  enum HormoneType {
    FSH
    LH
    E2_OESTRADIOL
    PROGESTERONE
    AMH
  }

  enum DocumentType {
    REFERRAL
    BLOOD_TEST_RESULT
    TREATMENT_PLAN
    OTHER
  }

  enum NotificationType {
    MEDICATION_REMINDER
    APPOINTMENT_REMINDER
  }

}

' ---------- Associationer (samme som domænemodellen) ----------

Patient "1" *-- "0..*" Diagnosis
Patient "1" *-- "0..*" FertilityJourney
Patient "1" *-- "0..*" Notification
Patient "1" *-- "0..*" DiaryEntry
Patient "1" *-- "0..*" Document

FertilityJourney "1" *-- "0..*" Round
FertilityJourney "1" *-- "0..*" Appointment

Round "1" *-- "0..*" Event
Round "1" *-- "0..*" HormoneLog
Round "1" *-- "0..*" MedicationLog
Medication "1" -- "0..*" MedicationLog

HormoneCurve "1" *-- "0..*" Point

@enduml

