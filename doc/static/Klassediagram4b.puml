@startuml
!pragma layout smetana

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classHeaderBackgroundColor white
skinparam packageBackgroundColor white
skinparam packageBorderColor #555555
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor #555555
skinparam ArrowColor black
skinparam enumBackgroundColor white
skinparam enumBorderColor black
hide circle

title Klassediagram 4b — persistence-laget (Simpl, PostgreSQL)\nConnectionPool laves én gang i Main og gives videre: Main → RouteConfig → Controller → Service → Mapper

package "persistence" {

  class ConnectionPool <<singleton>> {
    - {static} instance : ConnectionPool
    - {static} ds : HikariDataSource
    - ConnectionPool()
    - {static} createHikariConnectionPool(user : String, password : String, url : String, db : String) : HikariDataSource
    + {static} getInstance(user : String, password : String, url : String, db : String) : ConnectionPool
    + getConnection() : Connection
    + close() : void
  }

  class PatientMapper {
    - connectionPool : ConnectionPool
    + PatientMapper(connectionPool : ConnectionPool)
    + save(patient : Patient) : int
    + findByUsername(username : String) : Patient
    + findById(id : int) : Patient
    + updateProfile(id : int, firstName : String, lastName : String, dateOfBirth : LocalDate) : void
    + updatePassword(id : int, passwordHash : String) : void
    + delete(id : int) : void
  }

  class DiagnosisMapper {
    - connectionPool : ConnectionPool
    + DiagnosisMapper(connectionPool : ConnectionPool)
    + save(diagnosis : Diagnosis) : int
    + findByPatient(patientId : int) : List<Diagnosis>
    + delete(id : int, patientId : int) : boolean
    - mapRow(rs : ResultSet) : Diagnosis
  }

  class DocumentMapper {
    - connectionPool : ConnectionPool
    + DocumentMapper(connectionPool : ConnectionPool)
    + save(document : Document) : int
    + findByPatient(patientId : int) : List<Document>
    + delete(id : int, patientId : int) : boolean
    - mapRow(rs : ResultSet) : Document
  }

  class DiaryEntryMapper {
    - connectionPool : ConnectionPool
    + DiaryEntryMapper(connectionPool : ConnectionPool)
    + save(entry : DiaryEntry) : int
    + findByPatient(patientId : int) : List<DiaryEntry>
    + delete(id : int, patientId : int) : boolean
    - mapRow(rs : ResultSet) : DiaryEntry
  }

  class NotificationMapper {
    - connectionPool : ConnectionPool
    + NotificationMapper(connectionPool : ConnectionPool)
    + save(notification : Notification) : int
    + findByPatient(patientId : int) : List<Notification>
    + countUnread(patientId : int) : int
    + markRead(id : int, patientId : int) : boolean
    + markAllRead(patientId : int) : void
    - mapRow(rs : ResultSet) : Notification
  }

  class FertilityJourneyMapper {
    - connectionPool : ConnectionPool
    + FertilityJourneyMapper(connectionPool : ConnectionPool)
    + save(journey : FertilityJourney) : int
    + findActiveByPatient(patientId : int) : FertilityJourney
    + findByPatient(patientId : int) : List<FertilityJourney>
    + endJourney(id : int) : void
  }

  class AppointmentMapper {
    - connectionPool : ConnectionPool
    + AppointmentMapper(connectionPool : ConnectionPool)
    + save(appointment : Appointment) : int
    + findByJourney(fertilityJourneyId : int) : List<Appointment>
    - mapRow(rs : ResultSet) : Appointment
  }

  class RoundMapper {
    - connectionPool : ConnectionPool
    --
    + RoundMapper(connectionPool : ConnectionPool)
    + save(round : Round) : int
    .. læser fra viewet round_overview ..
    + findActiveByJourney(fertilityJourneyId : int) : Round
    + findByJourney(fertilityJourneyId : int) : List<Round>
    ..
    + endRound(id : int, endDate : LocalDate, result : Result) : void
    - mapRow(rs : ResultSet) : Round
  }

  class EventMapper {
    - connectionPool : ConnectionPool
    + EventMapper(connectionPool : ConnectionPool)
    + save(event : Event) : int
    + findByRound(roundId : int) : List<Event>
    - mapRow(rs : ResultSet) : Event
  }

  class HormoneLogMapper {
    - connectionPool : ConnectionPool
    + HormoneLogMapper(connectionPool : ConnectionPool)
    + save(log : HormoneLog) : int
    + findByRound(roundId : int) : List<HormoneLog>
    + delete(id : int, patientId : int) : boolean
    - mapRow(rs : ResultSet) : HormoneLog
  }

  class MedicationMapper {
    - connectionPool : ConnectionPool
    + MedicationMapper(connectionPool : ConnectionPool)
    + findAll() : List<Medication>
    + findByName(name : String) : Medication
    - mapRow(rs : ResultSet) : Medication
  }

  class MedicationLogMapper {
    - connectionPool : ConnectionPool
    + MedicationLogMapper(connectionPool : ConnectionPool)
    + save(log : MedicationLog) : int
    + findByRound(roundId : int) : List<MedicationLog>
    + markTaken(id : int, patientId : int) : boolean
    + markNotTaken(id : int, patientId : int) : boolean
    + delete(id : int, patientId : int) : boolean
    - mapRow(rs : ResultSet) : MedicationLog
  }
}

' Hver mapper får nøgleringen (ConnectionPool) i konstruktøren og låner en Connection pr. SQL-kald
' Retningen (-down-, -up- …) og de usynlige streger bestemmer kun placeringen (gitter rundt om ConnectionPool)

' række 1: patientens egne data
PatientMapper -down-> ConnectionPool
DiagnosisMapper -down-> ConnectionPool
DocumentMapper -down-> ConnectionPool
PatientMapper -[hidden]right- DiagnosisMapper
DiagnosisMapper -[hidden]right- DocumentMapper

' række 2: ConnectionPool i midten
DiaryEntryMapper -right-> ConnectionPool
NotificationMapper -left-> ConnectionPool

' række 3: forløb og runde
FertilityJourneyMapper -up-> ConnectionPool
AppointmentMapper -up-> ConnectionPool
RoundMapper -up-> ConnectionPool
FertilityJourneyMapper -[hidden]right- AppointmentMapper
AppointmentMapper -[hidden]right- RoundMapper

' række 4: det, der hører til en runde
EventMapper -up-> ConnectionPool
HormoneLogMapper -up-> ConnectionPool
MedicationLogMapper -up-> ConnectionPool
MedicationMapper -up-> ConnectionPool
FertilityJourneyMapper -[hidden]down- EventMapper
AppointmentMapper -[hidden]down- HormoneLogMapper
RoundMapper -[hidden]down- MedicationLogMapper
EventMapper -[hidden]right- HormoneLogMapper
HormoneLogMapper -[hidden]right- MedicationLogMapper
MedicationLogMapper -[hidden]right- MedicationMapper

' round_overview = view i schema_postgres.sql (runde + navnene på behandlingstype og resultat)

@enduml
