@startuml
!pragma layout smetana
skinparam monochrome true

title Domain Model - Simpl (Fertilitetsforløb)

' ---------- Patient (US5, US6, US7) ----------

' UserAccount er samlet ind i Patient (uge 41): de var 1-1 og oprettes altid sammen
object "<b>Patient</b>" as Patient {
  username
  password
  firstName
  lastName
  dateOfBirth
}

object "<b>Diagnosis</b>" as Diagnosis {
  name
  description
}

' ---------- Forløb og runde (US1, US10) ----------

object "<b>FertilityJourney</b>" as Journey {
  startDate
}

object "<b>Round</b>" as Round {
  roundNumber
  startDate
  endDate
}

' ---------- Ting på forløbet (US3) ----------

object "<b>Appointment</b>" as Appointment {
  dateTime
  location
}

' DiaryEntry ligger på patienten (ændret uge 40): dagbog skal kunne bruges før, mellem og efter forløb
object "<b>DiaryEntry</b>" as DiaryEntry {
  dateTime
  title
  content
}

' ---------- Ting på runden (US2, US8, US9) + Document på patienten (US11) ----------

object "<b>Event</b>" as Event {
  dateTime
  description
}

object "<b>Medication</b>" as Medication {
  name
  description
  unit
}

object "<b>MedicationLog</b>" as MedicationLog {
  scheduledDateTime
  dose
  taken
}

object "<b>HormoneLog</b>" as HormoneLog {
  dateTime
  value
  unit
}

' Document ligger på patienten (ændret uge 41): fx henvisning og blodprøvesvar kommer før første runde
object "<b>Document</b>" as Document {
  uploadDate
  title
  filePath
}

' ---------- Notifikationer (US12) ----------
' isRead står ikke her (vejledning aug.): læst/ulæst er et acceptkriterie på US12; kolonnen is_read findes kun i databasen

object "<b>Notification</b>" as Notification {
  dateTime
  title
  message
}

' ---------- Typer (uge 41): hver type har sin egen tabel, ligesom Medication ----------
' Round har ingen status mere: en runde er i gang, så længe endDate er tom

object "<b>JourneyStatus</b>" as JourneyStatus {
  name
}

object "<b>TreatmentType</b>" as TreatmentType {
  name
}

object "<b>Result</b>" as Result {
  name
}

object "<b>AppointmentType</b>" as AppointmentType {
  name
}

object "<b>EventType</b>" as EventType {
  name
}

object "<b>HormoneType</b>" as HormoneType {
  name
}

object "<b>DocumentType</b>" as DocumentType {
  name
}

object "<b>NotificationType</b>" as NotificationType {
  name
}

' ---------- Associationer ----------

Patient "1" *-- "0..*" Diagnosis : registers >
Patient "1" *-- "0..*" Journey : undergoes >
Patient "1" *-- "0..*" Notification : receives >
Patient "1" *-- "0..*" DiaryEntry : writes >
Patient "1" *-- "0..*" Document : uploads >

Journey "1" *-- "0..*" Round : consists of >
Journey "1" *-- "0..*" Appointment : schedules >

Round "1" *-- "0..*" Event : has >
Round "1" *-- "0..*" HormoneLog : records >
Round "1" *-- "0..*" MedicationLog : logs >
Medication "1" -- "0..*" MedicationLog : is taken in >

JourneyStatus "1" -- "0..*" Journey : describes >
TreatmentType "1" -- "0..*" Round : classifies >
Result "0..1" -- "0..*" Round : ends >
AppointmentType "1" -- "0..*" Appointment : classifies >
EventType "1" -- "0..*" Event : classifies >
HormoneType "1" -- "0..*" HormoneLog : classifies >
DocumentType "1" -- "0..*" Document : classifies >
NotificationType "1" -- "0..*" Notification : classifies >

note left of Journey
  En patient har højst ét forløb
  med status ACTIVE ad gangen.
end note

@enduml