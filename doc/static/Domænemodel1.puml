@startuml
!pragma layout smetana

title Domain Model - Simpl (Fertilitetsforløb)

' ---------- Bruger og patient (US5, US6, US7) ----------

object "<b>UserAccount</b>" as UserAccount #FFDAB9 {
  username
  password
}

object "<b>Patient</b>" as Patient #FFDAB9 {
  firstName
  lastName
  dateOfBirth
}

object "<b>Diagnosis</b>" as Diagnosis #FFDAB9 {
  name
  description
}

' ---------- Forløb og runde (US1, US10) ----------

object "<b>FertilityJourney</b>" as Journey #D6EAD8 {
  startDate
  status
}

object "<b>Round</b>" as Round #C1E8C1 {
  roundNumber
  treatmentType
  startDate
  endDate
  status
  result
}

' ---------- Ting på forløbet (US3) ----------

object "<b>Appointment</b>" as Appointment #FFF3B0 {
  dateTime
  appointmentType
  location
}

' DiaryEntry ligger på patienten (ændret uge 40): dagbog skal kunne bruges før, mellem og efter forløb
object "<b>DiaryEntry</b>" as DiaryEntry #FFDAB9 {
  dateTime
  title
  content
}

' ---------- Ting på runden (US2, US8, US9, US11) ----------

object "<b>Event</b>" as Event #FFF3B0 {
  dateTime
  eventType
  description
}

object "<b>Medication</b>" as Medication #FFF3B0 {
  name
  description
}

object "<b>MedicationLog</b>" as MedicationLog #FFF3B0 {
  scheduledDateTime
  dose
  unit
  taken
}

object "<b>HormoneLog</b>" as HormoneLog #FFF3B0 {
  dateTime
  hormoneType
  value
  unit
}

object "<b>Document</b>" as Document #FFF3B0 {
  title
  documentType
  filePath
}

' ---------- Notifikationer (US12) ----------

object "<b>Notification</b>" as Notification #FFF3B0 {
  dateTime
  notificationType
  title
  message
  isRead
}

' ---------- Associationer ----------

UserAccount "1" -- "1" Patient : logs in as >

Patient "1" *-- "0..*" Diagnosis : registers >
Patient "1" *-- "0..*" Journey : undergoes >
Patient "1" *-- "0..*" Notification : receives >
Patient "1" *-- "0..*" DiaryEntry : writes >

Journey "1" *-- "0..*" Round : consists of >
Journey "1" *-- "0..*" Appointment : schedules >

Round "1" *-- "0..*" Event : has >
Round "1" *-- "0..*" HormoneLog : records >
Round "1" *-- "0..*" Document : stores >
Round "1" *-- "0..*" MedicationLog : logs >
Medication "1" -- "0..*" MedicationLog : is taken in >

note left of Journey
  En patient har højst ét forløb
  med status ACTIVE ad gangen.
end note

@enduml