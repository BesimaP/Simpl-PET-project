erDiagram
  PATIENT ||--o{ DIAGNOSIS : registers
  PATIENT ||--o{ FERTILITY_JOURNEY : undergoes
  PATIENT ||--o{ NOTIFICATION : receives
  PATIENT ||--o{ DIARY_ENTRY : writes
  PATIENT ||--o{ DOCUMENT : uploads
  FERTILITY_JOURNEY ||--o{ ROUND : "consists of"
  FERTILITY_JOURNEY ||--o{ APPOINTMENT : schedules
  ROUND ||--o{ EVENT : has
  ROUND ||--o{ HORMONE_LOG : records
  ROUND ||--o{ MEDICATION_LOG : logs
  MEDICATION ||--o{ MEDICATION_LOG : "is taken in"
  JOURNEY_STATUS ||--o{ FERTILITY_JOURNEY : describes
  TREATMENT_TYPE ||--o{ ROUND : classifies
  RESULT |o--o{ ROUND : ends
  APPOINTMENT_TYPE ||--o{ APPOINTMENT : classifies
  EVENT_TYPE ||--o{ EVENT : classifies
  HORMONE_TYPE ||--o{ HORMONE_LOG : classifies
  DOCUMENT_TYPE ||--o{ DOCUMENT : classifies
  NOTIFICATION_TYPE ||--o{ NOTIFICATION : classifies

  PATIENT {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar username UK
    varchar password_hash
    varchar first_name
    varchar last_name
    date date_of_birth
  }
  DIAGNOSIS {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int patient_id FK
    varchar name
    text description
  }
  FERTILITY_JOURNEY {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int patient_id FK "UNIQUE WHERE journey_status_id = 1 (one_active_journey_per_patient)"
    date start_date
    int journey_status_id FK
  }
  ROUND {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int fertility_journey_id FK "UNIQUE WHERE end_date IS NULL (one_active_round_per_journey)"
    int round_number "CHECK > 0, UNIQUE (fertility_journey_id, round_number)"
    int treatment_type_id FK
    date start_date
    date end_date "NULL = i gang, CHECK end_date >= start_date"
    int result_id FK
  }
  APPOINTMENT {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int fertility_journey_id FK
    timestamp date_time
    int appointment_type_id FK
    varchar location
  }
  DIARY_ENTRY {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int patient_id FK
    timestamp date_time
    varchar title
    text content
  }
  EVENT {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int round_id FK
    timestamp date_time
    int event_type_id FK
    text description
  }
  MEDICATION {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
    varchar description
    varchar unit
  }
  MEDICATION_LOG {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int round_id FK
    int medication_id FK
    timestamp scheduled_date_time
    numeric dose "CHECK > 0"
    boolean taken
  }
  HORMONE_LOG {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int round_id FK
    timestamp date_time
    int hormone_type_id FK
    numeric value "CHECK >= 0"
    varchar unit
  }
  DOCUMENT {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int patient_id FK
    date upload_date
    varchar title
    int document_type_id FK
    varchar file_path
  }
  NOTIFICATION {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    int patient_id FK
    timestamp date_time
    int notification_type_id FK
    varchar title
    text message
    boolean is_read
  }
  JOURNEY_STATUS {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }
  TREATMENT_TYPE {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }
  RESULT {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }
  APPOINTMENT_TYPE {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }
  EVENT_TYPE {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }
  HORMONE_TYPE {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }
  DOCUMENT_TYPE {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }
  NOTIFICATION_TYPE {
    int id PK "GENERATED ALWAYS AS IDENTITY"
    varchar name UK
  }

