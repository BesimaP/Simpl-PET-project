  PATIENT {
    serial id PK
    varchar username UK
    varchar password_hash
    varchar first_name
    varchar last_name
    date date_of_birth
  }
  DIAGNOSIS {
    serial id PK
    int patient_id FK
    varchar name
    text description
  }
  FERTILITY_JOURNEY {
    serial id PK
    int patient_id FK
    date start_date
    int journey_status_id FK
  }
  ROUND {
    serial id PK
    int fertility_journey_id FK
    int round_number
    int treatment_type_id FK
    date start_date
    date end_date
    int result_id FK
  }
  APPOINTMENT {
    serial id PK
    int fertility_journey_id FK
    timestamp date_time
    int appointment_type_id FK
    varchar location
  }
  DIARY_ENTRY {
    serial id PK
    int patient_id FK
    timestamp date_time
    varchar title
    text content
  }
  EVENT {
    serial id PK
    int round_id FK
    timestamp date_time
    int event_type_id FK
    text description
  }
  MEDICATION {
    serial id PK
    varchar name UK
    varchar description
    varchar unit
  }
  MEDICATION_LOG {
    serial id PK
    int round_id FK
    int medication_id FK
    timestamp scheduled_date_time
    numeric dose
    boolean taken
  }
  HORMONE_LOG {
    serial id PK
    int round_id FK
    timestamp date_time
    int hormone_type_id FK
    numeric value
    varchar unit
  }
  DOCUMENT {
    serial id PK
    int patient_id FK
    date upload_date
    varchar title
    int document_type_id FK
    varchar file_path
  }
  NOTIFICATION {
    serial id PK
    int patient_id FK
    timestamp date_time
    int notification_type_id FK
    varchar title
    text message
    boolean is_read
  }
  JOURNEY_STATUS {
    serial id PK
    varchar name UK
  }
  TREATMENT_TYPE {
    serial id PK
    varchar name UK
  }
  RESULT {
    serial id PK
    varchar name UK
  }
