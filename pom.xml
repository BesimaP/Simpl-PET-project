<?xml version="1.0" encoding="UTF-8"?>
<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.example</groupId>
    <artifactId>Simpl-PET-project</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Javalin = webserveren. Modtager formularer, kalder controllere, sender sider tilbage -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>6.7.0</version>
        </dependency>
        <!-- Javalin logger via slf4j – uden denne får man en advarsel og ingen log -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>
        <!-- Databasedriver. Skiftes til org.postgresql:postgresql når vi går over til PostgreSQL -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <resources>
            <!-- resources/data: schema.sql lander som "schema.sql" på classpath (DatabaseInitializer læser den) -->
            <resource>
                <directory>resources/data</directory>
            </resource>
            <!-- resources: public/ (html, css, js, img) og templates/ lander på classpath, så Javalin kan servere dem -->
            <resource>
                <directory>resources</directory>
            </resource>
        </resources>
    </build>
</project>
