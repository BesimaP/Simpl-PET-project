<?xml version="1.0" encoding="UTF-8"?>
<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.example</groupId>
    <artifactId>Simpl-PET-project</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Javalin = webserveren. Modtager formularer, kalder controllere, sender sider tilbage -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>7.2.3</version>
        </dependency>
        <!-- Javalin logger via slf4j – uden denne får man en advarsel og ingen log -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>
        <!-- Thymeleaf = template-motor: HTML med th:text/th:each, som fyldes med data fra databasen (resources/templates) -->
        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf</artifactId>
            <version>3.1.3.RELEASE</version>
        </dependency>
        <!-- Bindeled mellem Javalin og Thymeleaf: gør ctx.render("side", model) muligt. Samme version som javalin -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin-rendering-thymeleaf</artifactId>
            <version>7.2.3</version>
        </dependency>
        <!-- JUnit 5 = unit tests af services (src/test/java). scope test = kun med når tests kører, ikke i selve programmet -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.0</version>
            <scope>test</scope>
        </dependency>
        <!-- HikariCP = connection pool: holder et antal databaseforbindelser åbne, som koden låner og giver tilbage. Hurtigere end at åbne en ny forbindelse ved hver forespørgsel -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.0.2</version>
        </dependency>
        <!-- PostgreSQL JDBC-driver: gør at Java kan tale med PostgreSQL-databasen (jdbc:postgresql://...) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.8</version>
        </dependency>
        <!-- BCrypt: hasher kodeord, så de aldrig gemmes i klartekst (NFR1) -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire = det plugin, der kører JUnit-testene (mvn test). En nyere version er nødvendig for JUnit 5.
                 Testene kører mod databasen Simpl_test i PostgreSQL – se src/test/java/services/TestData.java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

</project>

